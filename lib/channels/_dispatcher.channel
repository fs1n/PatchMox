#!/usr/bin/env bash
#
# Module: _dispatcher.channel (PatchMox)
# Description: Routes notifications to the enabled channels configured in NOTIFICATION_CHANNELS.
# Author: Frederik S. (fs1n) and PatchMox Contributors
# Date: 2026-07-15
#
# Dependencies: smtp.channel, msgraph.channel, webhook.channel
# Environment: NOTIFICATION_CHANNELS
# Usage: source lib/channels/_dispatcher.channel; notification_send "subject" "body" [content_type] [event_json]

# @function notification_send
# @description Dispatches update notifications to all enabled channels.
# @args subject body [content_type] [event_json]
#       event_json is the canonical event (if any); the webhook channel forwards it.
# @returns 0 if every channel succeeded, 1 if any channel failed or is unknown
function notification_send() {
    local subject=${1-}
    local body=${2-}
    local content_type="${3:-text/plain}"
    local event_json="${4-}"

    if [[ -z "${NOTIFICATION_CHANNELS-}" ]]; then
        log_debug "No notification channels configured (NOTIFICATION_CHANNELS empty), skipping"
        return 0
    fi

    log_debug "Dispatching notification to channels: $NOTIFICATION_CHANNELS (subject: $subject)"

    local rc=0 channel trimmed_channel
    local -a channels
    IFS=',' read -ra channels <<< "$NOTIFICATION_CHANNELS"
    for channel in "${channels[@]}"; do
        trimmed_channel="${channel#"${channel%%[![:space:]]*}"}"
        trimmed_channel="${trimmed_channel%"${trimmed_channel##*[![:space:]]}"}"
        [[ -z "$trimmed_channel" ]] && continue
        case "$trimmed_channel" in
            smtp) channel_send_smtp "$subject" "$body" "$content_type" || rc=1 ;;
            msgraph) channel_send_msgraph "$subject" "$body" "$content_type" || rc=1 ;;
            webhook) channel_send_webhook "$subject" "$body" "$content_type" "$event_json" || rc=1 ;;
            *) log_error "Unknown notification channel: $trimmed_channel"; rc=1 ;;
        esac
    done
    return "$rc"
}
