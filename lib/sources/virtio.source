#!/usr/bin/env bash
#
# Module: virtio.source (PatchMox)
# Description: Source module for VirtIO driver and QEMU Guest Agent checks on Proxmox VE.
# Author: Frederik S. (fs1n) and PatchMox Contributors
# Date: 2026-07-15
#
# Dependencies: pve.func (pvesh), jq, curl, grep, sed, awk, sort
# Environment: SCRIPT_DIR
# Usage: source lib/sources/virtio.source

FEDORA_VIRTIO_URL="https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/"
FEDORA_QEMU_GA_URL="https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-qemu-ga/"

VERSION_CACHE_TTL_MINUTES="${VERSION_CACHE_TTL_MINUTES:-60}"
VERSION_CACHE_FILE="${VERSION_CACHE_FILE:-${STATE_DIR:-${SCRIPT_DIR}/.state}/latest-versions.json}"
VERSION_CACHE_FORCE_REFRESH="${VERSION_CACHE_FORCE_REFRESH:-false}"

# @function _version_cache_path
# @description Returns the path to the version cache file, ensuring the directory exists.
function _version_cache_path() {
    local cache_dir
    cache_dir=$(dirname "$VERSION_CACHE_FILE")
    if [[ ! -d "$cache_dir" ]]; then
        mkdir -p "$cache_dir" 2>/dev/null || {
            echo "{}"
            return 1
        }
    fi
    echo "$VERSION_CACHE_FILE"
}

# @function _version_cache_is_valid
# @description Checks whether the version cache exists and is younger than TTL.
# @returns 0 if valid, 1 otherwise
function _version_cache_is_valid() {
    local cache_file
    cache_file=$(_version_cache_path) || return 1

    if [[ ! -f "$cache_file" ]]; then
        log_debug "Version cache miss: file not found ($cache_file)"
        return 1
    fi

    if [[ "$VERSION_CACHE_FORCE_REFRESH" == "true" ]]; then
        log_debug "Version cache miss: force refresh enabled"
        return 1
    fi

    if ! _version_cache_has_versions "$cache_file"; then
        log_debug "Version cache miss: cache contains no versions"
        return 1
    fi

    local fetched_at now_epoch fetched_epoch ttl_seconds
    fetched_at=$(jq -r '.fetched_at // empty' "$cache_file" 2>/dev/null)
    if [[ -z "$fetched_at" ]]; then
        log_debug "Version cache miss: no fetched_at timestamp in cache file"
        return 1
    fi

    now_epoch=$(date -u '+%s')
    fetched_epoch=$(date -u -d "$fetched_at" '+%s' 2>/dev/null || echo 0)
    ttl_seconds=$((VERSION_CACHE_TTL_MINUTES * 60))

    local age_seconds=$((now_epoch - fetched_epoch))
    if [[ $age_seconds -le $ttl_seconds ]]; then
        log_debug "Version cache hit: age ${age_seconds}s, TTL ${ttl_seconds}s (fetched_at: $fetched_at)"
        return 0
    fi

    log_debug "Version cache miss: expired (age ${age_seconds}s > TTL ${ttl_seconds}s)"
    return 1
}

# @function _version_cache_has_versions
# @description Checks that a cache file contains non-empty VirtIO and QEMU GA versions.
# @args cache_file (string)
# @returns 0 if both versions are present
function _version_cache_has_versions() {
    local cache_file="$1"
    [[ -f "$cache_file" ]] && jq -e '
        (.virtio.version // "" | length > 0) and (.qemu_ga.version // "" | length > 0)
    ' "$cache_file" >/dev/null 2>&1
}

# @function _refresh_version_cache
# @description Fetches both latest versions and writes the cache, but only if
#              both fetches succeeded. If the archive is unreachable, an expired
#              cache with valid versions is kept and used (with a warning).
# @returns 0 if usable versions are in the cache afterwards, 1 otherwise
function _refresh_version_cache() {
    local virtio_json qemu_ga_json
    log_info "Fetching latest VirtIO and QEMU GA versions from Fedora Archive"
    if virtio_json=$(_fetch_remote_virtio_version) && qemu_ga_json=$(_fetch_remote_qemu_ga_version); then
        _write_version_cache "$virtio_json" "$qemu_ga_json"
        return 0
    fi

    local cache_file
    cache_file=$(_version_cache_path) || return 1
    if _version_cache_has_versions "$cache_file"; then
        log_warn "Fedora Archive not reachable — using expired version cache from $(jq -r '.fetched_at' "$cache_file")"
        return 0
    fi

    log_error "Latest VirtIO / QEMU GA versions are unknown (archive not reachable, no cache)"
    return 1
}

# @function _read_version_cache
# @description Reads the cached VirtIO and QEMU GA versions.
# @returns JSON object with virtio and qemu_ga keys
function _read_version_cache() {
    local cache_file
    cache_file=$(_version_cache_path) || return 1
    jq -c '.' "$cache_file" 2>/dev/null
}

# @function _write_version_cache
# @description Writes the fetched versions to the cache file.
# @args virtio_json (string): JSON with version/release for VirtIO
#       qemu_ga_json (string): JSON with version/release for QEMU GA
function _write_version_cache() {
    local virtio_json="${1:-}"
    local qemu_ga_json="${2:-}"
    if [[ -z "$virtio_json" ]]; then
        virtio_json="{}"
    fi
    if [[ -z "$qemu_ga_json" ]]; then
        qemu_ga_json="{}"
    fi
    local cache_file
    cache_file=$(_version_cache_path) || return 1

    log_debug "Writing version cache to $cache_file (TTL: ${VERSION_CACHE_TTL_MINUTES}m)"
    jq -n \
        --arg fetched_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        --arg ttl_minutes "$VERSION_CACHE_TTL_MINUTES" \
        --argjson virtio "$virtio_json" \
        --argjson qemu_ga "$qemu_ga_json" \
        '{fetched_at: $fetched_at, ttl_minutes: ($ttl_minutes | tonumber), virtio: $virtio, qemu_ga: $qemu_ga}' \
        > "$cache_file"
}

# @function _fetch_remote_virtio_version
# @description Actually fetches the latest VirtIO version from Fedora People Archive.
function _fetch_remote_virtio_version() {
    log_debug "Fetching VirtIO version from $FEDORA_VIRTIO_URL"
    local archive_page
    archive_page=$(curl -sS --connect-timeout 15 --max-time 60 -w "\n%{http_code}" "${FEDORA_VIRTIO_URL}") || {
        log_error "Failed to fetch Fedora People Archive page (VirtIO): curl error"
        return 1
    }

    local http_code=$(echo "$archive_page" | tail -n1)
    local page_content=$(echo "$archive_page" | sed '$d')

    if [ "$http_code" != "200" ]; then
        log_error "Failed to access Fedora People Archive (VirtIO). HTTP Status: ${http_code}"
        return 1
    fi

    local latest_json
    latest_json=$(echo "$page_content" | awk '
        /virtio-win-[0-9.]+-([0-9]+)\// {
            start = match($0, /virtio-win-[0-9.]+-([0-9]+)\//)
            if (start > 0) {
                full_match = substr($0, RSTART, RLENGTH)
                gsub(/virtio-win-|\//, "", full_match)
                split(full_match, parts, "-")
                version = parts[1]
                if (match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2}/)) {
                    date = substr($0, RSTART, RLENGTH)
                    print version " " date
                }
            }
        }' |
        sort -V |
        tail -n1 |
        awk '{ver=$1; $1=""; sub(/^ /, "", $0); printf("{\"version\":\"%s\",\"release\":\"%s\"}\n", ver, $0)}'
    )

    if [ -z "$latest_json" ]; then
        log_error "Could not find any virtio-win directory versions in archive page"
        return 1
    fi

    log_debug "Fetched VirtIO version: $latest_json"
    echo "$latest_json"
}

# @function _fetch_remote_qemu_ga_version
# @description Actually fetches the latest QEMU Guest Agent version from Fedora People Archive.
function _fetch_remote_qemu_ga_version() {
    log_debug "Fetching QEMU GA version from $FEDORA_QEMU_GA_URL"
    local archive_page
    archive_page=$(curl -sS --connect-timeout 15 --max-time 60 -w "\n%{http_code}" "${FEDORA_QEMU_GA_URL}") || {
        log_error "Failed to fetch Fedora People Archive page (QEMU GA): curl error"
        return 1
    }

    local http_code=$(echo "$archive_page" | tail -n1)
    local page_content=$(echo "$archive_page" | sed '$d')

    if [ "$http_code" != "200" ]; then
        log_error "Failed to access Fedora People Archive (QEMU GA). HTTP Status: ${http_code}"
        return 1
    fi

    local latest_json
    latest_json=$(echo "$page_content" | awk '
        /qemu-ga-win-[^"]+\// {
            if (match($0, /qemu-ga-win-[0-9]+\.[0-9]+\.[0-9]+/)) {
                full_match = substr($0, RSTART, RLENGTH)
                sub(/qemu-ga-win-/, "", full_match)
                version = full_match
                if (match($0, /[0-9]{4}-[0-9]{2}-[0-9]{2}/)) {
                    date = substr($0, RSTART, RLENGTH)
                    print version " " date
                }
            }
        }' |
        sort -V |
        tail -n1 |
        awk '{ver=$1; $1=""; sub(/^ /, "", $0); printf("{\"version\":\"%s\",\"release\":\"%s\"}\n", ver, $0)}'
    )

    if [ -z "$latest_json" ]; then
        log_error "Could not find any qemu-ga-win directory versions in archive page"
        return 1
    fi

    log_debug "Fetched QEMU GA version: $latest_json"
    echo "$latest_json"
}

# @function fetch_latest_versions
# @description Returns the latest VirtIO and QEMU GA versions, using the cache if
#              valid. Checks / refreshes the shared cache only once per call.
# @returns JSON object {virtio: {version, release}, qemu_ga: {version, release}};
#          1 if the versions are unknown
function fetch_latest_versions() {
    if ! _version_cache_is_valid; then
        _refresh_version_cache || return 1
    fi
    local cache
    cache=$(_read_version_cache) || return 1
    jq -e '(.virtio.version // "" | length > 0) and (.qemu_ga.version // "" | length > 0)' >/dev/null 2>&1 <<< "$cache" || {
        log_error "Version cache contains no usable versions"
        return 1
    }
    jq -c '{virtio, qemu_ga}' <<< "$cache"
}

# @function get_windows_vms
# @description Discovers all Windows VMs on the cluster and returns their metadata as JSON.
#              Uses a single /cluster/resources call for all VMs + status, then only fetches
#              config for running VMs. Non-running VMs are included with ostype=null so the
#              caller can filter by status. Config fetches are limited to running VMs only,
#              avoiding unnecessary pvesh round-trips for stopped VMs or templates.
# @returns JSON object with VM IDs as keys
function get_windows_vms() {
    local cluster_resources
    if ! cluster_resources=$(pve_api get /cluster/resources --type vm) || [[ -z "$cluster_resources" ]]; then
        log_error "Failed to fetch /cluster/resources"
        echo '{}'
        return 1
    fi

    # All QEMU VMs from cluster resources with vmid, node, name, status, template.
    local qemu_vms
    qemu_vms=$(echo "$cluster_resources" | jq '
        [ .[] | select(.type == "qemu") |
          { vmid: (.vmid | tostring), node: .node, name: .name, status: .status, template: (.template // false) }
        ]')

    if [[ -z "$qemu_vms" || "$qemu_vms" == "[]" ]]; then
        log_debug "No QEMU VMs found on cluster"
        echo '{}'
        return 0
    fi

    local total_qemu
    total_qemu=$(echo "$qemu_vms" | jq 'length')
    log_debug "Found $total_qemu QEMU VM(s) in cluster resources"

    local json_items=""
    local vmid node vm_name status vm_config os_type vmgenid vmgenid_json vm_obj

    while IFS= read -r vmid; do
        IFS= read -r node
        IFS= read -r vm_name
        IFS= read -r status

        # Skip templates entirely — they are never update targets.
        # Only fetch config for running VMs; stopped VMs get ostype=null
        # (cheaper than a pvesh round-trip per stopped VM).
        if [[ "$status" != "running" ]]; then
            vm_obj=$(jq -n \
                --arg node "$node" \
                --arg name "$vm_name" \
                --arg status "$status" \
                --arg vmid "$vmid" \
                --argjson vmgenid null \
                '{($vmid): {node: $node, name: $name, ostype: null, status: $status, vmgenid: $vmgenid}}')
            json_items+="$vm_obj"$'\n'
            continue
        fi

        if ! vm_config=$(pve_get_vm_config "$node" "$vmid") || [[ -z "$vm_config" ]]; then
            log_warn "Could not fetch config for VM $vmid on $node, skipping"
            continue
        fi

        os_type=$(echo "$vm_config" | jq -r '.ostype // empty')

        # Skip non-Windows VMs early — no need to include them in the result.
        if [[ -z "$os_type" || "$os_type" != w* ]]; then
            log_debug "VM $vmid ($vm_name) is not Windows (ostype: ${os_type:-null}), skipping"
            continue
        fi

        log_debug "VM $vmid ($vm_name) is Windows (ostype: $os_type) on node $node"

        vmgenid=$(echo "$vm_config" | jq -r '.vmgenid // empty')
        if [[ -z "$vmgenid" ]]; then
            vmgenid_json=null
        else
            vmgenid_json="\"$vmgenid\""
        fi

        vm_obj=$(jq -n \
            --arg node "$node" \
            --arg name "$vm_name" \
            --arg ostype "$os_type" \
            --arg status "$status" \
            --arg vmid "$vmid" \
            --argjson vmgenid "$vmgenid_json" \
            '{($vmid): {node: $node, name: $name, ostype: $ostype, status: $status, vmgenid: $vmgenid}}')

        json_items+="$vm_obj"$'\n'
    done <<< "$(echo "$qemu_vms" | jq -r '.[] | .vmid, .node, .name, .status')"

    if [[ -n "$json_items" ]]; then
        jq -s 'add' <<< "$json_items"
    else
        echo '{}'
    fi
}

# @function _sanitize_version_string
# @description Strips whitespace and control characters from a guest-agent version string.
#              Returns empty if the result does not look like a dotted version.
# @args raw (string): raw version string from guest agent
function _sanitize_version_string() {
    local raw="$1"
    local cleaned
    cleaned=$(echo "$raw" | tr -d '\r\n\t' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    if [[ "$cleaned" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
        echo "$cleaned"
    else
        log_debug "Sanitized version string rejected (not dotted-numeric): '$cleaned' (raw: '$raw')"
        echo ""
    fi
}

# @function get_windows_virtio_version
# @description Query VirtIO driver version installed in a Windows VM via the guest agent API
# @args node (string): Proxmox node name
#       vmid (string): Proxmox VM ID
# @returns 0 and version on stdout (empty if not installed); 1 if the guest query failed
function get_windows_virtio_version() {
    local node=$1
    local vmid=$2
    log_debug "Querying VirtIO version via guest agent for VM $vmid on $node"
    # `exit 0`: a suppressed non-terminating error (unreadable registry value,
    # missing WOW6432Node) would otherwise make powershell exit 1 and the VM be skipped.
    local script='Get-ItemProperty "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*" -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -like "*virtio*installer*" } | Select-Object -ExpandProperty DisplayVersion -First 1; exit 0'
    local raw_version
    raw_version=$(pve_guest_powershell "$node" "$vmid" "$script") || return 1
    local sanitized
    sanitized=$(_sanitize_version_string "$raw_version")
    log_debug "VM $vmid VirtIO: raw='$raw_version' sanitized='$sanitized'"
    echo "$sanitized"
}

# @function get_windows_QEMU_GA_version
# @description Query QEMU Guest Agent version installed in a Windows VM via the guest agent API
# @args node (string): Proxmox node name
#       vmid (string): Proxmox VM ID
# @returns 0 and version on stdout (empty if not found); 1 if the guest query failed
function get_windows_QEMU_GA_version() {
    local node=$1
    local vmid=$2
    log_debug "Querying QEMU GA version via guest agent for VM $vmid on $node"
    local script='foreach ($path in @("C:\Program Files\Qemu-ga\qemu-ga.exe", "C:\Program Files (x86)\Qemu-ga\qemu-ga.exe")) { if (Test-Path $path) { (Get-Item $path).VersionInfo.FileVersion; break } }; exit 0'
    local raw_version
    raw_version=$(pve_guest_powershell "$node" "$vmid" "$script") || return 1
    local sanitized
    sanitized=$(_sanitize_version_string "$raw_version")
    log_debug "VM $vmid QEMU GA: raw='$raw_version' sanitized='$sanitized'"
    echo "$sanitized"
}

# @function get_vm_genid
# @description Retrieve VM generation ID for clone detection; falls back to ctime+name if vmgenid not set
# @args windows_vms_json (string): JSON object of all Windows VMs
#       node (string): Proxmox node name
#       vmid (string): Proxmox VM ID
function get_vm_genid() {
    local windows_vms_json=$1
    local node=$2
    local vmid=$3

    local vmgenid
    vmgenid=$(echo "$windows_vms_json" | jq -r --arg vmid "$vmid" '.[$vmid].vmgenid // empty')

    if [[ -z "$vmgenid" || "$vmgenid" == "null" ]]; then
        local vm_config
        vm_config=$(pve_get_vm_config "$node" "$vmid") || vm_config='{}'
        local ctime
        ctime=$(echo "$vm_config" | jq -r '.meta // empty' | grep -oP 'ctime=\K[0-9]+' || echo "0")
        local vm_name
        vm_name=$(echo "$vm_config" | jq -r '.name // "unnamed"')
        echo "fallback-${ctime}-${vm_name}"
        log_warn "VM $vmid has no vmgenid, using fallback identifier" >&2
    else
        echo "$vmgenid"
    fi
}

# @function get_vm_creation_date
# @description Extract VM creation date/time from Proxmox metadata
# @args node (string): Proxmox node name
#       vmid (string): Proxmox VM ID
function get_vm_creation_date() {
    local node=$1
    local vmid=$2

    local ctime
    ctime=$(pve_get_vm_config "$node" "$vmid" | \
        jq -r '.meta // empty' | \
        grep -oP 'ctime=\K[0-9]+' || true)

    if [ -n "$ctime" ]; then
        date -d "@$ctime" '+%Y-%m-%d %H:%M:%S'
    else
        echo "unknown"
    fi
}
