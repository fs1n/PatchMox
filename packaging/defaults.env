# PatchMox package defaults - installed as /usr/share/patchmox/defaults.env.
# Loaded by bin/patchmox before the config file. Do not edit: changes are lost
# on upgrade. Override any value in /etc/patchmox/patchmox.env instead.
# Values already present in the environment take precedence.

PATCHMOX_CONFIG="${PATCHMOX_CONFIG:-/etc/patchmox/patchmox.env}"
STATE_DIR="${STATE_DIR:-/var/lib/patchmox/state}"
QUEUE_DIR="${QUEUE_DIR:-/var/lib/patchmox/queue}"
LOG_DIR="${LOG_DIR:-/var/log/patchmox}"
POLICY_DIR="${POLICY_DIR:-/usr/share/patchmox/policies}"
POLICY_LOCAL_DIR="${POLICY_LOCAL_DIR:-/etc/patchmox/policies.d}"
